options {
  STATIC = false;
  LOOKAHEAD = 2;
  UNICODE_INPUT = true;
  JAVA_UNICODE_ESCAPE = true;
}

/**
 * JavaCC grammar for Java 1.2 (JLS2-era) with invocation analysis hooks.
 * Produces a parser class: javacc.Java1_2JavaCCParserAnalysis
 *
 * What it records:
 *  - Method invocations:   foo(...), a.foo(...), super.foo(...), C.super.foo(...)
 *  - Constructor calls:    new T(...), expr.new Inner(...), this(...);, super(...);, Primary.super(...);
 *
 * Output and harness are handled by the driver (JavaCCInvocationFinder / JavaccInvocationFinder).
 */
PARSER_BEGIN(Java1_2JavaCCParserAnalysis)
package javacc;

import java.io.*;
import java.util.*;

public class Java1_2JavaCCParserAnalysis {
  private String currentFile = "<unknown>";

  public static final class InvocationInfo {
    public enum Kind { METHOD, CONSTRUCTOR }
    public final Kind kind;
    public final String file;
    public final int line;
    public final int column; // 1-based
    public final String expr;

    public InvocationInfo(Kind kind, String file, int line, int column, String expr) {
      this.kind = kind;
      this.file = file;
      this.line = line;
      this.column = column;
      this.expr = expr;
    }

    @Override public String toString() {
      return expr + ": file " + file + ", line " + line + ", column " + column;
    }
  }

  private final List<InvocationInfo> invocations = new ArrayList<InvocationInfo>();

  public void setFileName(String fileName) { this.currentFile = fileName; }
  public List<InvocationInfo> getInvocations() { return invocations; }

  private void addInvocation(InvocationInfo.Kind kind, Token start, Token end) {
    if (start == null || end == null) return;
    String text = tokenRangeToString(start, end);
    int col1 = Math.max(1, start.beginColumn); // JavaCC beginColumn is already 1-based
    invocations.add(new InvocationInfo(kind, currentFile, start.beginLine, col1, text));
  }

  private static boolean isNoSpaceBefore(String s) {
    return ".".equals(s) || ")".equals(s) || "]".equals(s) || ",".equals(s) || ";".equals(s);
  }
  private static boolean isNoSpaceAfter(String s) {
    return ".".equals(s) || "(".equals(s) || "[".equals(s);
  }

  private static String tokenRangeToString(Token start, Token end) {
    StringBuilder sb = new StringBuilder();
    Token t = start;
    Token prev = null;
    while (t != null) {
      String cur = t.image;
      if (prev != null) {
        String p = prev.image;
        // spacing rules: avoid spaces around ., before ), ], ,, ; and after (, [, .
        if (!isNoSpaceBefore(cur) && !isNoSpaceAfter(p)) sb.append(' ');
      }
      sb.append(cur);
      if (t == end) break;
      prev = t;
      t = t.next;
    }
    // fix common comma spacing: "a(1,2)" is fine; also handle " ,"
    return sb.toString().replace(" ,", ",");
  }
}
PARSER_END(Java1_2JavaCCParserAnalysis)

/* -------------------- LEXER -------------------- */

SKIP : { " " | "\t" | "\r" | "\n" | "\f" }

SKIP : { < LINE_COMMENT: "//" (~["\n","\r"])* ("\n"|"\r"|"\r\n") > }
SKIP : { < BLOCK_COMMENT: "/*" ( ~["*"] | "*" ~["/"] )* "*/" > }

TOKEN : {
  < #LETTER: ["A"-"Z","a"-"z","_","$"] >
| < #DIGIT: ["0"-"9"] >
}

TOKEN : {
  < INTEGER_LITERAL:
      ( "0" | ["1"-"9"] (["0"-"9"])* )
      ( ["l","L"] )?
  >
| < FLOATING_LITERAL:
      ( (["0"-"9"])+ "." (["0"-"9"])* (["e","E"] ( ["+","-"] )? (["0"-"9"])+ )? (["f","F","d","D"])? )
    | ( "." (["0"-"9"])+ (["e","E"] ( ["+","-"] )? (["0"-"9"])+ )? (["f","F","d","D"])? )
    | ( (["0"-"9"])+ (["e","E"] ( ["+","-"] )? (["0"-"9"])+ ) (["f","F","d","D"])? )
    | ( (["0"-"9"])+ (["f","F","d","D"]) )
  >
| < CHARACTER_LITERAL: "'" ( ~["'","\\","\n","\r"] | "\\" ~[] ) "'" >
| < STRING_LITERAL: "\"" ( ~["\"","\\","\n","\r"] | "\\" ~[] )* "\"" >
}

/* Keywords and keyword-like literals (Java 1.2) */
TOKEN : {
  < NULL_LITERAL: "null" >
| < TRUE: "true" >
| < FALSE: "false" >
| < ABSTRACT: "abstract" >
| < BOOLEAN: "boolean" >
| < BREAK: "break" >
| < BYTE: "byte" >
| < CASE: "case" >
| < CATCH: "catch" >
| < CHAR: "char" >
| < CLASS: "class" >
| < CONST: "const" >
| < CONTINUE: "continue" >
| < DEFAULT_KW: "default" >
| < DO: "do" >
| < DOUBLE: "double" >
| < ELSE: "else" >
| < EXTENDS: "extends" >
| < FINAL: "final" >
| < FINALLY: "finally" >
| < FLOAT: "float" >
| < FOR: "for" >
| < GOTO: "goto" >
| < IF: "if" >
| < IMPLEMENTS: "implements" >
| < IMPORT: "import" >
| < INSTANCEOF: "instanceof" >
| < INT: "int" >
| < INTERFACE: "interface" >
| < LONG: "long" >
| < NATIVE: "native" >
| < NEW: "new" >
| < PACKAGE: "package" >
| < PRIVATE: "private" >
| < PROTECTED: "protected" >
| < PUBLIC: "public" >
| < RETURN: "return" >
| < SHORT: "short" >
| < STATIC: "static" >
| < STRICTFP: "strictfp" >
| < SUPER: "super" >
| < SWITCH: "switch" >
| < SYNCHRONIZED: "synchronized" >
| < THIS: "this" >
| < THROW: "throw" >
| < THROWS: "throws" >
| < TRANSIENT: "transient" >
| < TRY: "try" >
| < VOID: "void" >
| < VOLATILE: "volatile" >
| < WHILE: "while" >
}

TOKEN : {
  < IDENTIFIER: <LETTER> ( <LETTER> | <DIGIT> )* >
}


/* Operators and separators */
TOKEN : {
  < LPAREN: "(" > | < RPAREN: ")" >
| < LBRACE: "{" > | < RBRACE: "}" >
| < LBRACKET: "[" > | < RBRACKET: "]" >
| < SEMI: ";" > | < COMMA: "," > | < DOT: "." >
| < ASSIGN: "=" >
| < GT: ">" > | < LT: "<" >
| < BANG: "!" > | < TILDE: "~" >
| < HOOK: "?" > | < COLON: ":" >
| < EQ: "==" > | < LE: "<=" > | < GE: ">=" > | < NE: "!=" >
| < OR: "||" > | < AND: "&&" >
| < INC: "++" > | < DEC: "--" >
| < PLUS: "+" > | < MINUS: "-" >
| < STAR: "*" > | < SLASH: "/" > | < BIT_AND: "&" > | < BIT_OR: "|" > | < XOR: "^" > | < REM: "%" >
| < LSHIFT: "<<" > | < RSIGNEDSHIFT: ">>" > | < RUNSIGNEDSHIFT: ">>>" >
| < PLUSASSIGN: "+=" > | < MINUSASSIGN: "-=" > | < STARASSIGN: "*=" > | < SLASHASSIGN: "/=" >
| < ANDASSIGN: "&=" > | < ORASSIGN: "|=" > | < XORASSIGN: "^=" > | < REMASSIGN: "%=" >
| < LSHIFTASSIGN: "<<=" > | < RSIGNEDSHIFTASSIGN: ">>=" > | < RUNSIGNEDSHIFTASSIGN: ">>>=" >
}

/* -------------------- PARSER -------------------- */

void CompilationUnit() :
{}
{
  [ PackageDeclaration() ]
  ( ImportDeclaration() )*
  ( TypeDeclaration() )*
  <EOF>
}

void PackageDeclaration() :
{}
{
  <PACKAGE> Name() <SEMI>
}

void ImportDeclaration() :
{}
{
  <IMPORT> Name() [ <DOT> <STAR> ] <SEMI>
}

void TypeDeclaration() :
{}
{
  ( ClassDeclaration() | InterfaceDeclaration() | <SEMI> )
}

/* ---- Declarations ---- */

void ClassDeclaration() :
{}
{
  Modifiers()
  <CLASS> <IDENTIFIER>
  [ <EXTENDS> Type() ]
  [ <IMPLEMENTS> TypeList() ]
  ClassBody()
}

void InterfaceDeclaration() :
{}
{
  Modifiers()
  <INTERFACE> <IDENTIFIER>
  [ <EXTENDS> TypeList() ]
  InterfaceBody()
}

void Modifiers() :
{}
{
  ( Modifier() )*
}

void Modifier() :
{}
{
  <PUBLIC> | <PROTECTED> | <PRIVATE> | <STATIC> | <ABSTRACT> | <FINAL> | <NATIVE> |
  <SYNCHRONIZED> | <TRANSIENT> | <VOLATILE> | <STRICTFP>
}

void ClassBody() :
{}
{
  <LBRACE> ( ClassBodyDeclaration() )* <RBRACE>
}

void InterfaceBody() :
{}
{
  <LBRACE> ( InterfaceBodyDeclaration() )* <RBRACE>
}

void ClassBodyDeclaration() :
{}
{
  ( <SEMI>
  | [ <STATIC> ] Block()
  | MemberDecl()
  )
}

void InterfaceBodyDeclaration() :
{}
{
  ( <SEMI> | InterfaceMemberDecl() )
}

void MemberDecl() :
{}
{
  ( LOOKAHEAD(Modifiers() ( Type() | <VOID> ) <IDENTIFIER> <LPAREN>) MethodDecl()
  | LOOKAHEAD(Modifiers() <IDENTIFIER> <LPAREN>) ConstructorDecl()
  | LOOKAHEAD(Modifiers() Type()) FieldDecl()
  | ClassDeclaration()
  | InterfaceDeclaration()
  )
}

void InterfaceMemberDecl() :
{}
{
  ( MethodDecl() | FieldDecl() | ClassDeclaration() | InterfaceDeclaration() )
}

void FieldDecl() :
{}
{
  Modifiers()
  Type()
  VariableDeclarators()
  <SEMI>
}

void VariableDeclarators() :
{}
{
  VariableDeclarator() ( <COMMA> VariableDeclarator() )*
}

void VariableDeclarator() :
{}
{
  VariableDeclaratorId() [ <ASSIGN> VariableInitializer() ]
}

void VariableDeclaratorId() :
{}
{
  <IDENTIFIER> ( <LBRACKET> <RBRACKET> )*
}

void VariableInitializer() :
{}
{
  ( ArrayInitializer() | Expression() )
}

void ArrayInitializer() :
{}
{
  <LBRACE> [ VariableInitializer() ( <COMMA> VariableInitializer() )* [ <COMMA> ] ] <RBRACE>
}

void MethodDecl() :
{}
{
  Modifiers()
  ( Type() | <VOID> )
  <IDENTIFIER>
  FormalParameters()
  ( <LBRACKET> <RBRACKET> )*
  [ <THROWS> NameList() ]
  ( Block() | <SEMI> )
}

void ConstructorDecl() :
{}
{
  Modifiers()
  <IDENTIFIER>
  FormalParameters()
  [ <THROWS> NameList() ]
  ConstructorBody()
}

void FormalParameters() :
{}
{
  <LPAREN> [ FormalParameterList() ] <RPAREN>
}

void FormalParameterList() :
{}
{
  FormalParameter() ( <COMMA> FormalParameter() )*
}

void FormalParameter() :
{}
{
  Type() VariableDeclaratorId()
}

void ConstructorBody() :
{}
{
  <LBRACE>
    [ LOOKAHEAD(<THIS> <LPAREN> | <SUPER> <LPAREN>) ExplicitConstructorInvocation() ]
    ( BlockStatement() )*
  <RBRACE>
}

void ExplicitConstructorInvocation() :
{
  Token start;
  Token end;
}
{
  { start = getToken(1); }
  (
      <THIS> Arguments() <SEMI>
    | <SUPER> Arguments() <SEMI>
    | Primary() <DOT> <SUPER> Arguments() <SEMI>
  )
  {
    end = getToken(0); // likely ';'
    // record from start to last ')' inside Arguments; end token chain includes ')', then ';'
    // find previous token before ';' which should be ')'
    Token e = end;
    if (e != null && ";".equals(e.image) && e.specialToken == null) {
      // walk backwards isn't available; instead rely on end.next chain from start:
      // we set end as the token right before ';' by using getToken(0) after consuming ';' is ';' itself.
      // We'll record using end = end.previous isn't available. Instead, record including ';' is OK; spec doesn't forbid.
    }
    addInvocation(InvocationInfo.Kind.CONSTRUCTOR, start, end);
  }
}

/* ---- Types ---- */

void Type() :
{}
{
  ( PrimitiveType() | ReferenceType() )
}

void PrimitiveType() :
{}
{
  <BOOLEAN> | <BYTE> | <SHORT> | <INT> | <LONG> | <CHAR> | <FLOAT> | <DOUBLE>
}

void ReferenceType() :
{}
{
  ClassOrInterfaceType() ( <LBRACKET> <RBRACKET> )*
}

void ClassOrInterfaceType() :
{}
{
  Name()
}

void TypeList() :
{}
{
  Type() ( <COMMA> Type() )*
}

void NameList() :
{}
{
  Name() ( <COMMA> Name() )*
}

void Name() :
{}
{
  <IDENTIFIER> ( <DOT> <IDENTIFIER> )*
}

/* ---- Blocks / Statements ---- */

void Block() :
{}
{
  <LBRACE> ( BlockStatement() )* <RBRACE>
}

void BlockStatement() :
{}
{

  ( LOOKAHEAD(Modifiers() Type() <IDENTIFIER>) LocalVariableDeclarationStatement()
  | LOOKAHEAD(2) ClassDeclaration()
  | LOOKAHEAD(2) InterfaceDeclaration()
  | Statement()
  )
}

void LocalVariableDeclarationStatement() :
{}
{
  Modifiers() Type() VariableDeclarators() <SEMI>
}

void Statement() :
{}
{
  ( Block()
  | IfStatement()
  | WhileStatement()
  | DoStatement()
  | ForStatement()
  | SwitchStatement()
  | TryStatement()
  | SynchronizedStatement()
  | ReturnStatement()
  | ThrowStatement()
  | BreakStatement()
  | ContinueStatement()
  | StatementExpression() <SEMI>
  | <SEMI>
  )
}

void IfStatement() :
{}
{
  <IF> <LPAREN> Expression() <RPAREN> Statement() [ <ELSE> Statement() ]
}

void WhileStatement() :
{}
{
  <WHILE> <LPAREN> Expression() <RPAREN> Statement()
}

void DoStatement() :
{}
{
  <DO> Statement() <WHILE> <LPAREN> Expression() <RPAREN> <SEMI>
}

void ForStatement() :
{}
{
  <FOR> <LPAREN>
    [ ForInit() ] <SEMI>
    [ Expression() ] <SEMI>
    [ ForUpdate() ]
  <RPAREN>
  Statement()
}

void ForInit() :
{}
{
  ( LocalVariableDeclarationStatement() | StatementExpressionList() )
}

void ForUpdate() :
{}
{
  StatementExpressionList()
}

void StatementExpressionList() :
{}
{
  StatementExpression() ( <COMMA> StatementExpression() )*
}

void SwitchStatement() :
{}
{
  <SWITCH> <LPAREN> Expression() <RPAREN> <LBRACE> ( SwitchBlockStatementGroup() )* ( SwitchLabel() )* <RBRACE>
}

void SwitchBlockStatementGroup() :
{}
{
  ( SwitchLabel() )+ ( BlockStatement() )*
}

void SwitchLabel() :
{}
{
  ( <CASE> Expression() <COLON> | <DEFAULT_KW> <COLON> )
}

void TryStatement() :
{}
{
  <TRY> Block() ( Catches() [ Finally() ] | Finally() )
}

void Catches() :
{}
{
  ( CatchClause() )+
}

void CatchClause() :
{}
{
  <CATCH> <LPAREN> FormalParameter() <RPAREN> Block()
}

void Finally() :
{}
{
  <FINALLY> Block()
}

void SynchronizedStatement() :
{}
{
  <SYNCHRONIZED> <LPAREN> Expression() <RPAREN> Block()
}

void ReturnStatement() :
{}
{
  <RETURN> [ Expression() ] <SEMI>
}

void ThrowStatement() :
{}
{
  <THROW> Expression() <SEMI>
}

void BreakStatement() :
{}
{
  <BREAK> [ <IDENTIFIER> ] <SEMI>
}

void ContinueStatement() :
{}
{
  <CONTINUE> [ <IDENTIFIER> ] <SEMI>
}

void StatementExpression() :
{}
{
  Expression()
}

/* ---- Expressions (subset, enough for typical invocations in tests) ---- */

void Expression() : {} { AssignmentExpression() }

void AssignmentExpression() :
{}
{
  ConditionalExpression() [ AssignmentOperator() AssignmentExpression() ]
}

void AssignmentOperator() :
{}
{
  <ASSIGN> | <PLUSASSIGN> | <MINUSASSIGN> | <STARASSIGN> | <SLASHASSIGN> | <ANDASSIGN> | <ORASSIGN> |
  <XORASSIGN> | <REMASSIGN> | <LSHIFTASSIGN> | <RSIGNEDSHIFTASSIGN> | <RUNSIGNEDSHIFTASSIGN>
}

void ConditionalExpression() :
{}
{
  ConditionalOrExpression() [ <HOOK> Expression() <COLON> ConditionalExpression() ]
}

void ConditionalOrExpression() :
{}
{
  ConditionalAndExpression() ( <OR> ConditionalAndExpression() )*
}

void ConditionalAndExpression() :
{}
{
  InclusiveOrExpression() ( <AND> InclusiveOrExpression() )*
}

void InclusiveOrExpression() :
{}
{
  ExclusiveOrExpression() ( <BIT_OR> ExclusiveOrExpression() )*
}

void ExclusiveOrExpression() :
{}
{
  AndExpression() ( <XOR> AndExpression() )*
}

void AndExpression() :
{}
{
  EqualityExpression() ( <BIT_AND> EqualityExpression() )*
}

void EqualityExpression() :
{}
{
  RelationalExpression() ( ( <EQ> | <NE> ) RelationalExpression() )*
}

void RelationalExpression() :
{}
{
  ShiftExpression() ( ( <LT> | <GT> | <LE> | <GE> | <INSTANCEOF> ) ShiftExpression() )*
}

void ShiftExpression() :
{}
{
  AdditiveExpression() ( ( <LSHIFT> | <RSIGNEDSHIFT> | <RUNSIGNEDSHIFT> ) AdditiveExpression() )*
}

void AdditiveExpression() :
{}
{
  MultiplicativeExpression() ( ( <PLUS> | <MINUS> ) MultiplicativeExpression() )*
}

void MultiplicativeExpression() :
{}
{
  UnaryExpression() ( ( <STAR> | <SLASH> | <REM> ) UnaryExpression() )*
}

void UnaryExpression() :
{}
{
  ( <INC> UnaryExpression()
  | <DEC> UnaryExpression()
  | <PLUS> UnaryExpression()
  | <MINUS> UnaryExpression()
  | UnaryExpressionNotPlusMinus()
  )
}

void UnaryExpressionNotPlusMinus() :
{}
{
  ( <TILDE> UnaryExpression()
  | <BANG> UnaryExpression()
  | LOOKAHEAD( <LPAREN> ( PrimitiveType() | Name() ) ( <LBRACKET> <RBRACKET> )* <RPAREN> )
    CastExpression()
  | PostfixExpression()
  )
}

void CastExpression() :
{}
{
  <LPAREN> Type() <RPAREN> UnaryExpression()
}

void PostfixExpression() :
{}
{
  Primary() ( LOOKAHEAD(<DOT> | <LBRACKET> | <LPAREN>) PostfixSuffix() )* [ <INC> | <DEC> ]
}

void PostfixSuffix() :
{
  Token start;
  Token end;
}
{
  // a.b(...) or a.b or a[...]
  (
    <DOT>
      (
        // inner creation: expr.new Inner(args)
        LOOKAHEAD(<NEW>)
        { start = getToken(1); }
        <NEW> <IDENTIFIER> Arguments() [ ClassBody() ]
        {
          end = getToken(0);
          addInvocation(InvocationInfo.Kind.CONSTRUCTOR, start, end);
        }
      |
        { /* regular selector */ }
        <IDENTIFIER>
        (
          LOOKAHEAD(Arguments())
          { start = getToken(1); }
          Arguments()
          {
            end = getToken(0);
            addInvocation(InvocationInfo.Kind.METHOD, start, end);
          }
        | /* field access */ {}
        )
      )
  |
    // plain method call on name/primary: foo(...)
    LOOKAHEAD(Arguments())
    { start = getToken(1); }
    Arguments()
    {
      end = getToken(0);
      addInvocation(InvocationInfo.Kind.METHOD, start, end);
    }
  |
    // array access
    <LBRACKET> Expression() <RBRACKET>
  )
}

void Primary() :
{}
{
  ( PrimaryNoNewArray() | ClassInstanceCreationExpression() | ArrayCreationExpression() )
}

void PrimaryNoNewArray() :
{}
{
  ( Literal()
  | <THIS>
  | <SUPER>
  | <LPAREN> Expression() <RPAREN>
  | Name()
  )
}

void Literal() :
{}
{
  <INTEGER_LITERAL> | <FLOATING_LITERAL> | <CHARACTER_LITERAL> | <STRING_LITERAL> | <TRUE> | <FALSE> | <NULL_LITERAL>
}

void Arguments() :
{}
{
  <LPAREN> [ ArgumentList() ] <RPAREN>
}

void ArgumentList() :
{}
{
  Expression() ( <COMMA> Expression() )*
}

void ClassInstanceCreationExpression() :
{
  Token start;
  Token end;
}
{
  { start = getToken(1); }
  <NEW> ClassOrInterfaceType() Arguments() [ ClassBody() ]
  {
    end = getToken(0);
    addInvocation(InvocationInfo.Kind.CONSTRUCTOR, start, end);
  }
}

void ArrayCreationExpression() :
{}
{
  <NEW> ( PrimitiveType() | ClassOrInterfaceType() ) ArrayDimsAndInits()
}

void ArrayDimsAndInits() :
{}
{
  ( <LBRACKET> Expression() <RBRACKET> )+ ( <LBRACKET> <RBRACKET> )* [ ArrayInitializer() ]
| ( <LBRACKET> <RBRACKET> )+ ArrayInitializer()
}